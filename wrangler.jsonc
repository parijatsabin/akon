{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker script name. Lowercase is a platform rule, not a preference:
  // Cloudflare rejects anything else with "Expected name to be ... alphanumeric
  // and lowercase with dashes only". Renaming is create-new + delete-old, never
  // in place -- the previous script was "akon".
  "name": "anok",

  // Pinned deliberately. Without it wrangler deploys to whichever account the
  // current `wrangler login` happens to hold, which is how a deploy silently
  // lands somewhere new after an account switch. Pinning turns that into a
  // loud failure instead. Change it only alongside a real account move, and
  // confirm with `wrangler whoami`.
  "account_id": "7243055b095af954817389aad90c5c96",
  "compatibility_date": "2026-06-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Custom domains, not workers.dev: this account never registered a
  // *.workers.dev subdomain, so without these the Worker deploys but nothing
  // addresses it. custom_domain:true makes Cloudflare own the DNS record for
  // the hostname -- it replaces the stale proxied A records the zone transfer
  // left behind, which were pointing at Cloudflare's own anycast IPs and
  // serving Error 1000 ("DNS points to prohibited IP").
  "routes": [
    { "pattern": "anokperfumes.com.np", "custom_domain": true },
    { "pattern": "www.anokperfumes.com.np", "custom_domain": true }
  ]
}
