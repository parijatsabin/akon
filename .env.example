# Copy to .env.local and fill in. .env.local is git-ignored (.gitignore: .env*).
# Never commit real values.

# ── Browser (inlined into the bundle at build time) ───────────
# The anon key is designed to be public. Its blast radius is exactly the RLS
# policy matrix in supabase/migrations/0014_rls.sql — read content, insert a
# contact/newsletter submission, nothing else.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Scripts only — NEVER prefixed VITE_, never imported under src/ ────
# Bypasses RLS entirely. Used by scripts/ and by the admin-create-user edge
# function. If this leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ── Initial superadmin (scripts/bootstrap-superadmin.ts) ──────
# The password is read from here and never written to a migration, a seed
# file, or the repository. Set it, run the bootstrap once, then remove it.
SUPERADMIN_USERNAME=9868348282
SUPERADMIN_PASSWORD=
