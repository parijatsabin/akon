# Public Supabase configuration for production builds — COMMITTED ON PURPOSE.
#
# WHY: these two values are inlined into the JS bundle at build time, so they
# are already served to every visitor. Committing them leaks nothing that
# https://akon.abionsoft.workers.dev/assets/index-*.js does not already hand
# out. What it buys is a build that configures itself: Cloudflare Workers
# Builds, a fresh clone, a CI runner — all produce a working site with no
# dashboard variables to forget. Every blank-screen deploy this project has had
# traced back to a build environment that lacked them.
#
# The anon key is a *publishable* key. Its blast radius is exactly the RLS
# policy matrix in supabase/migrations/ — read published content, insert a
# contact or newsletter row, nothing else.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY or any SUPERADMIN_* value in this file.
# Those bypass RLS and belong in .env.local, which stays git-ignored.
#
# .env.local still overrides this file locally, so pointing at a different
# project for development needs no change here.

VITE_SUPABASE_URL=https://cilrqtdwkfytjhltluln.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_mDMkojBed4TsEpeaINceqg_bxzZiCSw
